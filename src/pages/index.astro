---
// Static page; the story list loads from /data.json (built by `npm run data`).
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>New Yorker Fiction by Length</title>
    <meta name="description" content="Every New Yorker short story since 1940, ranked by word count, with links to each story." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <style is:global>
/* Layout: one reading column; a sticky filter bar; each story is a ledger row with its word count as a bar */
:root {
  --bg: #f5f6f4;
  --surface: #ffffff;
  --ink: #1c1e23;
  --muted: #5e636d;
  --rule: #dcdfe3;
  --accent: #2c4f8f;
  --accent-soft: #dfe6f3;
  --done: #5f7f56;
  --serif: "Newsreader", Georgia, "Times New Roman", serif;
  --sans: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #14161a; --surface: #1c1f24; --ink: #e8e9ec; --muted: #9aa0aa; --rule: #2d3138;
    --accent: #8fb0ea; --accent-soft: #24324b; --done: #9cc08f; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #14161a; --surface: #1c1f24; --ink: #e8e9ec; --muted: #9aa0aa; --rule: #2d3138;
  --accent: #8fb0ea; --accent-soft: #24324b; --done: #9cc08f; color-scheme: dark;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.5; }
.wrap { max-width: 860px; margin: 0 auto; padding-inline: 16px; padding-block: 40px 80px; }
header h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(30px, 6vw, 44px); line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 10px; text-wrap: balance; }
header p { font-family: var(--serif); font-size: 18px; color: var(--muted); margin: 0; max-width: 62ch; }
.stats { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 18px; font-size: 13px; color: var(--muted); }
.stats b { font-family: var(--mono); font-weight: 500; color: var(--ink); }

.bar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg); border-bottom: 1px solid var(--rule); padding-block: 14px; margin-top: 28px; display: grid; gap: 10px; }
.row1 { display: flex; flex-wrap: wrap; gap: 8px; }
.row1 input[type=search] { flex: 1 1 220px; min-width: 0; }
input[type=search], select { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 7px 10px; }
input:focus-visible, select:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: 500 13px var(--sans); color: var(--ink); background: transparent; border: 1px solid var(--rule); border-radius: 999px; padding: 4px 11px; cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
.row3 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font-size: 13px; color: var(--muted); }
.row3 label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
.btn { font: 600 13px var(--sans); color: var(--accent); background: var(--accent-soft); border: 0; border-radius: 6px; padding: 7px 12px; cursor: pointer; }
.count { margin-left: auto; font-family: var(--mono); }

ol { list-style: none; margin: 0; padding: 0; }
li.story { display: grid; grid-template-columns: 92px 1fr auto; gap: 4px 16px; padding-block: 16px; border-bottom: 1px solid var(--rule); align-items: start; }
li.story.pick { background: var(--accent-soft); margin-inline: -12px; padding-inline: 12px; border-radius: 6px; }
.len { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.len .w { font-size: 15px; font-weight: 500; }
.len .m { font-size: 12px; color: var(--muted); }
.meter { height: 3px; background: var(--rule); border-radius: 2px; margin-top: 6px; overflow: hidden; }
.meter i { display: block; height: 100%; background: var(--accent); }
.body { min-width: 0; }
.body a.t { font-family: var(--serif); font-size: 20px; line-height: 1.2; color: var(--ink); text-decoration: none; }
.body a.t:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
.by { font-size: 13px; color: var(--muted); margin-top: 3px; }
.by .rank { font-family: var(--mono); }
.fw { font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--done); border: 1px solid currentColor; border-radius: 4px; padding: 0 5px; margin-left: 4px; white-space: nowrap; }
.dek { font-family: var(--serif); font-size: 15px; color: var(--muted); margin: 6px 0 0; max-width: 62ch; }
.read { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); cursor: pointer; white-space: nowrap; padding-top: 4px; }
li.story.is-read .t { color: var(--muted); }
li.story.is-read .read { color: var(--done); }
input[type=checkbox] { accent-color: var(--accent); }
.acts { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.hide, .linkbtn { font: 12px var(--sans); color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.hide:hover, .linkbtn:hover { color: var(--accent); }
.more { display: block; margin: 24px auto 0; }
.empty { padding: 40px 0; color: var(--muted); font-family: var(--serif); font-size: 18px; }
footer { margin-top: 40px; font-size: 13px; color: var(--muted); max-width: 66ch; }
@media (max-width: 560px) {
  li.story { grid-template-columns: 1fr auto; }
  .len { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 10px; }
  .len .meter { flex: 1; margin: 0; align-self: center; }
  .count { margin-left: 0; }
}
footer a { color: var(--accent); }
</style>
  </head>
  <body>


<div class="wrap">
  <header>
    <h1>New Yorker Fiction, Shortest First</h1>
    <p>Every story from The New Yorker’s fiction archive, ranked by word count, so a busy day still gets its story.</p>
    <div class="stats" id="stats"></div>
  </header>

  <div class="bar">
    <div class="row1">
      <input type="search" id="q" placeholder="Search title or author" aria-label="Search title or author">
      <select id="decade" aria-label="Decade"><option value="">All decades</option></select>
      <select id="sort" aria-label="Sort order">
        <option value="short">Shortest first</option>
        <option value="long">Longest first</option>
        <option value="new">Newest first</option>
        <option value="old">Oldest first</option>
      </select>
    </div>
    <div class="chips" id="chips" role="group" aria-label="Length"></div>
    <div class="row3">
      <label><input type="checkbox" id="fictionOnly"> Known fiction writers only</label>
      <label><input type="checkbox" id="modern"> 1993 and later</label>
      <label><input type="checkbox" id="hideRead"> Hide stories I’ve read</label>
      <button class="btn" id="random" type="button">Pick one for today</button>
      <button class="linkbtn" id="showHidden" type="button" hidden></button>
      <span class="count" id="count"></span>
    </div>
  </div>

  <ol id="list"></ol>
  <button class="btn more" id="more" type="button" hidden>Show more</button>

  <footer>
    Word counts come from each story’s page on newyorker.com and include the title and byline, so treat them as close estimates. Reading time assumes 240 words per minute. “Fiction writer” marks authors known mainly for novels or short stories: anyone with a story here from 1993 on (when the magazine began filing humor separately, as Shouts & Murmurs), anyone listed on Writing Atlas, and older authors identified by name. Use “1993 and later” for the most reliable set. The list starts in 1940: before then, the archive labels nearly every humor piece and column as fiction, with no way to tell them apart. The New Yorker’s online Flash Fiction series (summers of 2017 and 2020–23) is left out, as is anything under 500 words. Every piece under 2,500 words was reviewed from its opening lines, and humor sketches, parodies and essays the magazine filed as fiction were removed. Poems and cartoon features that the archive files under fiction have been filtered out; if one slipped through, use Hide. Some archive stories have only a summary on the website; the full text is in the scanned issue linked from that page. Their length is unknown, so they sit under “Length unknown” instead of in the ranking. Your “read” checkmarks are saved in this browser only. <a href="/new_yorker_stories_by_word_count.csv" download>Download the full list as a spreadsheet (CSV)</a>.
  </footer>
</div>

<script is:inline>
const BANDS = [
  { id: "all", label: "Any length", min: 0, max: Infinity },
  { id: "u1k", label: "500–1,000", min: 0, max: 1000 },
  { id: "1-2", label: "1,000–2,000", min: 1000, max: 2000 },
  { id: "2-4", label: "2,000–4,000", min: 2000, max: 4000 },
  { id: "4-7", label: "4,000–7,000", min: 4000, max: 7000 },
  { id: "7+", label: "7,000+", min: 7000, max: Infinity },
  { id: "unk", label: "Length unknown", unknown: true },
];
const PAGE = 150, WPM = 240;
let showHidden = false;
const $ = id => document.getElementById(id);
const store = {
  get(k, d) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
};
let DATA = [], read = new Set(store.get("read", [])), hidden = new Set(store.get("hidden", [])), band = store.get("band", "all"), shown = PAGE, pick = null;
const fmt = n => n.toLocaleString("en-US");
const mins = w => { const m = Math.max(1, Math.round(w / WPM)); return m < 60 ? `${m} min` : `${Math.floor(m/60)} hr ${m%60} min`; };
const esc = s => s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const date = d => new Date(d + "T12:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

function filtered() {
  const q = $("q").value.trim().toLowerCase(), dec = $("decade").value, b = BANDS.find(x => x.id === band) || BANDS[0];
  const hide = $("hideRead").checked;
  let r = DATA.filter(s => (b.unknown ? s.w == null : b.id === "all" || (s.w != null && s.w >= b.min && s.w < b.max))
    && (!dec || Math.floor(s.y / 10) * 10 == dec)
    && (!hide || !read.has(s.p))
    && (!$("fictionOnly").checked || s.f === "F")
    && (!$("modern").checked || s.y >= 1993)
    && (showHidden ? hidden.has(s.p) : !hidden.has(s.p))
    && (!q || s.lc.includes(q)));
  const so = $("sort").value;
  if (so === "long") r = r.filter(s => s.w != null).reverse().concat(r.filter(s => s.w == null));
  else if (so === "new") r = r.slice().sort((a, b) => b.d.localeCompare(a.d));
  else if (so === "old") r = r.slice().sort((a, b) => a.d.localeCompare(b.d));
  return r;
}

function render() {
  const r = filtered();
  $("count").textContent = `${fmt(r.length)} ${r.length === 1 ? "story" : "stories"}`;
  const list = $("list");
  if (!r.length) { list.innerHTML = `<li class="empty">No stories match. Try a wider length or clear the search.</li>`; $("more").hidden = true; return; }
  let rows = r.slice(0, shown);
  if (pick && !rows.includes(pick)) rows = [pick, ...rows];
  list.innerHTML = rows.map(s => `
    <li class="story${read.has(s.p) ? " is-read" : ""}${s === pick ? " pick" : ""}" data-p="${s.p}">
      <div class="len">${s.w == null ? `<div class="w">—</div><div class="m">scan only</div>` : `<div class="w">${fmt(s.w)}</div><div class="m">${mins(s.w)}</div><div class="meter"><i style="width:${Math.min(100, s.w / 120).toFixed(1)}%"></i></div>`}</div>
      <div class="body">
        <a class="t" href="https://www.newyorker.com${s.p}" target="_blank" rel="noopener">${esc(s.t)}</a>
        <div class="by">${esc(s.a || "Unknown author")}${s.f === "F" ? ` <span class="fw" title="Known primarily as a fiction writer">fiction writer</span>` : ""} · ${date(s.d)}${s.rank ? ` · <span class="rank">#${fmt(s.rank)}</span> shortest` : ""}</div>
        ${s.k ? `<p class="dek">${esc(s.k)}</p>` : ""}
      </div>
      <div class="acts"><label class="read"><input type="checkbox" ${read.has(s.p) ? "checked" : ""} aria-label="Mark “${esc(s.t)}” as read"> Read</label><button class="hide" type="button" title="${hidden.has(s.p) ? "Put this back in the list" : "Hide this if it isn’t a story (a cartoon, a poem)"}">${hidden.has(s.p) ? "Unhide" : "Hide"}</button></div>
    </li>`).join("");
  $("more").hidden = r.length <= shown;
  $("more").textContent = `Show more (${fmt(r.length - shown)} left)`;
}

function chips() {
  $("chips").innerHTML = BANDS.map(b => `<button class="chip" type="button" data-b="${b.id}" aria-pressed="${b.id === band}">${b.label}</button>`).join("");
}

function reset() { shown = PAGE; pick = null; render(); }

$("chips").addEventListener("click", e => {
  const b = e.target.closest(".chip"); if (!b) return;
  band = b.dataset.b; store.set("band", band); chips(); reset();
});
["q", "decade", "sort", "hideRead", "fictionOnly", "modern"].forEach(id => $(id).addEventListener("input", reset));
$("list").addEventListener("click", e => {
  const b = e.target.closest("button.hide"); if (!b) return;
  const p = b.closest("li.story").dataset.p;
  hidden.has(p) ? hidden.delete(p) : hidden.add(p);
  store.set("hidden", [...hidden]); hiddenLink(); render();
});
function hiddenLink() {
  $("showHidden").hidden = !hidden.size && !showHidden;
  $("showHidden").textContent = showHidden ? "Back to the list" : `Hidden (${hidden.size})`;
}
$("showHidden").addEventListener("click", () => { showHidden = !showHidden; hiddenLink(); reset(); });
$("more").addEventListener("click", () => { shown += PAGE; render(); });
$("list").addEventListener("change", e => {
  const li = e.target.closest("li.story"); if (!li) return;
  e.target.checked ? read.add(li.dataset.p) : read.delete(li.dataset.p);
  store.set("read", [...read]);
  li.classList.toggle("is-read", e.target.checked);
  stats();
});
$("random").addEventListener("click", () => {
  const r = filtered().filter(s => !read.has(s.p));
  if (!r.length) return;
  pick = r[Math.floor(Math.random() * r.length)];
  render(); window.scrollTo({ top: $("list").offsetTop - 160, behavior: "smooth" });
});

function stats() {
  const ws = DATA.filter(s => s.w != null).map(s => s.w), med = ws[Math.floor(ws.length / 2)];
  const under2 = ws.filter(w => w < 2000).length;
  const y0 = Math.min(...DATA.map(s => s.y)), y1 = Math.max(...DATA.map(s => s.y));
  $("stats").innerHTML = `<span><b>${fmt(DATA.length)}</b> stories, ${y0}–${y1}</span><span><b>${fmt(DATA.length - ws.length)}</b> with length unknown</span><span>Median <b>${fmt(med)}</b> words</span><span><b>${fmt(under2)}</b> under 2,000 words</span><span><b>${fmt(read.size)}</b> marked read</span>`;
}

fetch("data.json").then(r => r.json()).then(rows => {
  DATA = rows.map((r, i) => ({ t: r[0], a: r[1], y: r[2], d: r[3], w: r[4], p: r[5], k: r[6], f: r[7], rank: r[4] == null ? 0 : i + 1, lc: (r[0] + " " + r[1]).toLowerCase() }));
  const decs = [...new Set(DATA.map(s => Math.floor(s.y / 10) * 10))].sort();
  $("decade").insertAdjacentHTML("beforeend", decs.map(d => `<option value="${d}">${d}s</option>`).join(""));
  chips(); stats(); hiddenLink(); render();
}).catch(() => { $("list").innerHTML = `<li class="empty">The story list didn’t load. Reload the page to try again.</li>`; });
</script>

  </body>
</html>
